@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <!--Utiliser ce div pour afficher la 1ere vue partielle-->
    <div id="partial1"></div>
    <!--Utiliser ce div pour afficher la 2e vue partielle-->
    <div class="d-flex gap-3 p-3">
        <input type="text" id="text" class="form-control" />
        <input type="number" id="number" class="form-control"></input>
        <button onclick="VuePartielle()" class="btn btn-primary">AJAX avec data</button>
    </div>
    <div id="partial2"></div>
</div>

@section Scripts {
    <script>
        $(function() {
            $.get('/Home/Partielle', null,
                function(data) {
                    $("#partial1").html(data);
                });
        });
    </script>

    <script>

        function VuePartielle() {
            let data = {
                qty: $("#number").val(),
                texte: $("#text").val()
            };
            $(function() {
                $.get('/Home/Partielle2', data,
                    function(htmlData) {
                        $("#partial2").html(htmlData);
                    });
            });
        }

    </script>
}